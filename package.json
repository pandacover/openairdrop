{
  "name": "beam",
  "productName": "Beam",
  "version": "1.0.0",
  "description": "End-to-end encrypted, peer-to-peer text and file sharing on your local network.",
  "main": "src/main/main.js",
  "author": "Beam",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:second": "electron . --beam-profile=.profiles/second",
    "test": "node --test test/core.test.js",
    "test:e2e": "node scripts/e2e.js",
    "icons": "node scripts/gen-icons.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "app.beam.lan",
    "productName": "Beam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Beam finds and sends files to your other devices on the local network."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  }
}
