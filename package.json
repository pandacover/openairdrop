{
  "name": "beam",
  "productName": "Beam",
  "version": "0.0.1",
  "description": "End-to-end encrypted, peer-to-peer text and file sharing on your local network.",
  "main": "src/main/main.js",
  "author": "Beam",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:second": "electron . --beam-profile=.profiles/second",
    "test": "node --test test/core.test.js",
    "test:e2e": "node scripts/e2e.js",
    "icons": "node scripts/gen-icons.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "app.beam.lan",
    "productName": "Beam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Beam-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Beam finds and sends files to your other devices on the local network."
      },
      "artifactName": "Beam-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pandacover",
        "repo": "openairdrop"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
